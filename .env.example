# Server
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/payflow_upi
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false
MAX_PAYMENT_PAISE=50000000
INITIAL_DEMO_BALANCE_PAISE=10000000
USE_MONGO_TRANSACTIONS=true

# Client (client/.env)
VITE_API_URL=http://localhost:5000/api
